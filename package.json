{
  "name": "hueplay",
  "version": "0.3.3",
  "description": "Color Compass — HSL vs OKLCH playground and colour-model field guide, served at senseikatana.com/hueplay/*",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "bun test",
    "e2e": "node tests/e2e/run.mjs",
    "build": "astro check && bun test && astro build && node tests/e2e/run.mjs",
    "build:preview": "bun run build && astro preview",
    "build:deploy": "bun run build && wrangler deploy",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "author": "Sergio Jurado",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.8",
    "bun-types": "^1.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro,json,jsonc,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
