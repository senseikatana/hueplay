{
  "name": "hueplay",
  "version": "0.4.3",
  "description": "Color Compass — HSL vs OKLCH playground and colour-model field guide, served at senseikatana.com/hueplay/*",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "test": "bun test",
    "build": "astro check && bun test && astro build && node tests/e2e/run.mjs",
    "build:preview": "bun run build && astro preview",
    "build:deploy": "bun run build && wrangler deploy",
    "release:check": "node scripts/check-release.mjs",
    "release": "node scripts/release.mjs",
    "release:sync": "node scripts/sync-release.mjs",
    "prepare": "husky"
  },
  "author": "Sergio Jurado",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "astro": "^7.4.13",
    "bun-types": "^1.4.5",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-astro": "^1.3.4",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.169.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
